# Copy to .env and fill in. Everything here is read by the app at runtime —
# `grep -rn "process.env" app lib utils` is the source of truth if this drifts.

# --- Database ----------------------------------------------------------------
# Prisma connects with this. POSTGRES_* are consumed by docker-compose.yml when
# you run the local database, so keep them in sync with DATABASE_URL.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"

# --- Auth --------------------------------------------------------------------
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (AWS SES) ---------------------------------------------------------
# Prefixed with KLAPI_ because Vercel reserves the AWS_* namespace.
# With USE_LOCAL_SES=true (what `pnpm dev` sets) mail goes to the local mock on
# :8005 instead and the credentials are unused.
KLAPI_AWS_REGION="eu-north-1"
KLAPI_AWS_ACCESS_KEY_ID=""
KLAPI_AWS_SECRET_ACCESS_KEY=""
AWS_SES_FROM_EMAIL="klapi@example.com"

# --- Item photos (S3) --------------------------------------------------------
AWS_BUCKET_NAME=""
NEXT_PUBLIC_AWS_ITEM_PHOTOS_URL=""

# --- Cron --------------------------------------------------------------------
# Shared secret for the /api/cron/* routes; Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Without it the crons return 401.
CRON_SECRET=""

# --- Google Workspace user sync ----------------------------------------------
# Nightly `cron/syncWorkspaceUsers` reads the Workspace roster and provisions /
# soft-deletes Klapi accounts to match. Leave these blank to switch the sync off
# — the cron then fails loudly instead of touching anyone.
#
# The key is a service-account JSON key, base64-encoded (base64 survives a paste
# into the Vercel env editor; raw JSON is accepted too). Its client id needs
# these two scopes — and only these — authorised under Admin console → Security
# → API controls → Domain-wide delegation:
#   https://www.googleapis.com/auth/admin.directory.user.readonly
#   https://www.googleapis.com/auth/admin.directory.group.member.readonly
GOOGLE_WORKSPACE_SA_KEY=""
# The admin account the service account impersonates. Needs the "read users"
# admin privilege; the SA has no directory access of its own.
GOOGLE_WORKSPACE_SUBJECT="admin@example.com"
# The troop's domain. Read by the sync, and also sent to Google as the `hd`
# hint on sign-in, so a member signed into both this account and a personal
# Gmail is not asked which one to use. Blank = no hint, and the chooser is
# whatever Google would show anyway.
GOOGLE_WORKSPACE_DOMAIN="example.com"
# Membership in this group is what makes someone a Klapi user.
GOOGLE_WORKSPACE_GROUP="jasenet@example.com"
# Comma-separated domain addresses the sync ignores completely — never
# provisioned, never deactivated. For the robot accounts that are Workspace
# users but not people; the member group's whole-organisation member would
# otherwise sweep them in.
GOOGLE_WORKSPACE_EXCLUDE="admin@example.com,dev@example.com"
# Circuit breaker: abort the run rather than soft-delete more than this many
# accounts at once. Defaults to 10.
WORKSPACE_SYNC_MAX_DEACTIVATIONS="10"

# --- Loans on the shared calendar --------------------------------------------
# Every loan is mirrored as an event on one shared Google Calendar, with the
# borrower invited as a guest so it lands in their own calendar too. Leave this
# blank to switch the mirror off entirely — loans then just don't get events.
#
# The calendar's id (Calendar settings → "Kalenterin tunnus"). Share the
# calendar with the *service account's own email address* and give it "Tee
# muutoksia tapahtumiin" — that is the whole authorisation story here. The
# calendar scope is deliberately NOT in the domain-wide delegation grant above:
# nothing in Klapi needs to reach anybody's private calendar.
#
# Reuses GOOGLE_WORKSPACE_SA_KEY for the key and GOOGLE_WORKSPACE_DOMAIN to
# decide who may be invited as a guest.
GOOGLE_CALENDAR_ID=""
