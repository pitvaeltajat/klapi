generator client {
  provider = "prisma-client-js"
}

// Markdown output is pure text generation — prisma-erd-generator writes the
// mermaid source and returns before it ever reaches mermaid-cli/puppeteer, so
// this is cheap enough to leave enabled on every `prisma generate`. Don't point
// it at .pdf/.svg/.png: those rasterize through a headless Chrome download.
generator erd {
  provider = "prisma-erd-generator"
  output   = "../.erd.md"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String         @id @default(cuid())
  name                     String?
  email                    String?        @unique
  emailVerified            DateTime?
  image                    String?
  // Soft delete: admin "delete user" sets this instead of hard-deleting the row,
  // so the user's loans and loan history survive. Deleted users are filtered out
  // of auth (can't log in), admin/loaner listings, elevation, and email/cron
  // recipients. Unset it (back to null) to restore the account.
  deletedAt                DateTime?
  // Provenance for `deletedAt`: true when the nightly Google Workspace sync
  // stamped it, false when a human did. The sync only ever *undoes* its own
  // deletions — an admin who deletes someone by hand stays deleted even while
  // they are still a Workspace member, instead of being resurrected overnight.
  deletedBySync            Boolean        @default(false)
  // Set when this row was merged into another and soft-deleted: everything it
  // owned (loans, email logs, history) now hangs off `mergedInto`. It exists to
  // answer "why is this account deleted, and where did its kamat go?" — and to
  // make the merge reversible. The row is kept rather than hard-deleted so its
  // email stays claimed; `lib/auth.ts` then refuses that Google login instead
  // of silently minting a fresh empty duplicate.
  mergedIntoId             String?
  mergedInto               User?          @relation("UserMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom               User[]         @relation("UserMerge")
  group                    Group          @default(USER)
  password                 String?
  passwordExpiresAt        DateTime?
  // Recoverable (AES-256-GCM encrypted) copy of the KIOSK user's current
  // password, so admins can view it in the admin panel. `password` stays the
  // bcrypt hash used for auth; this is display-only. KIOSK rows only.
  kioskPasswordEnc         String?
  kioskElevatePin          String?
  username                 String?        @unique
  emailNewLoanNotification Boolean        @default(true)
  emailWeeklyReminder      Boolean        @default(true)
  // Opt-in, unlike the others: the "lainasi päättyy pian" mail is off unless the
  // borrower asks for it. Most people know when their loan ends, and the overdue
  // escalation already covers the ones who don't.
  emailExpiringReminder    Boolean        @default(false)
  emailOldBoxNotification  Boolean        @default(true)
  emailOverdueNotification Boolean        @default(true)
  accounts                 Account[]
  loans                    Loan[]
  sessions                 Session[]
  emailLogs                EmailLog[]
  loanHistoryEntries       LoanHistory[]
  itemHistoryEntries       ItemHistory[]

  @@index([deletedAt])
}

model Item {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  amount              Int
  locationId          String?
  type                ItemType             @default(normal)
  deletedAt           DateTime?
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservations        Reservation[]
  categories          Category[]           @relation("CategoryToItem")
  announcements       Announcement[]
  reportAffectedItems ReportAffectedItem[]
  history             ItemHistory[]
  templateItems       TemplateItem[]

  @@index([deletedAt])
}

/// A named, pre-picked set of items ("Vartion maastoretki") that a loaner can
/// drop into the cart in one go. Purely a shortcut for filling the cart: loans
/// keep no link back to the template they came from.
model Template {
  id          String         @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       TemplateItem[]
}

model TemplateItem {
  id         String   @id @default(cuid())
  templateId String
  itemId     String
  amount     Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([templateId, itemId])
}

model ItemHistory {
  id        String            @id @default(cuid())
  itemId    String
  action    ItemHistoryAction
  details   Json?
  actedById String?
  createdAt DateTime          @default(now())
  item      Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actedBy   User?             @relation(fields: [actedById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
}

enum ItemHistoryAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
  PROMOTED
}

/// A *published* huomio: the notice loaners see on a kama while browsing.
/// Its unpublished counterpart is `Report` — the note a loaner writes about a
/// loan. The UI calls both "huomio"; the split is only who can see it.
model Announcement {
  id        String           @id @default(cuid())
  message   String
  kind      AnnouncementKind @default(TIEDOKSI)
  createdAt DateTime         @default(now())
  expiresAt DateTime?
  item      Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String?
  /// Set when an admin published this out of a loaner's report. Several
  /// announcements (one per affected kama) can share one reportId.
  report    Report?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportId  String?

  @@index([reportId])
}

/// KORJATTAVAA carries the "something is wrong" lifecycle and shows red to
/// loaners; TIEDOKSI is a neutral heads-up that just stands until removed.
enum AnnouncementKind {
  KORJATTAVAA
  TIEDOKSI
}

model Location {
  name        String
  description String?
  id          String  @id @default(cuid())
  items       Item[]
}

model Box {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loans       Loan[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  items       Item[]  @relation("CategoryToItem")
}

model Reservation {
  id     String            @id @default(cuid())
  amount Int
  itemId String
  loanId String
  status ReservationStatus @default(ACCEPTED)
  item   Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  loan   Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Loan {
  id           String        @id @default(cuid())
  status       LoanStatus    @default(ACCEPTED)
  startTime    DateTime
  endTime      DateTime
  userId       String
  description  String?       @db.VarChar(100)
  loaner       String?
  boxId        String?
  box          Box?          @relation(fields: [boxId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reports      Report[]
  emailLogs    EmailLog[]
  history      LoanHistory[]
}

model LoanHistory {
  id        String            @id @default(cuid())
  loanId    String
  action    LoanHistoryAction
  details   Json?
  actedById String?
  createdAt DateTime          @default(now())
  loan      Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  actedBy   User?             @relation(fields: [actedById], references: [id], onDelete: SetNull)

  @@index([loanId, createdAt])
}

enum LoanHistoryAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  CANCELLED
  STARTED
  RETURNED_TO_BOX
  PROCESSED_FROM_BOX
}

/// An *unpublished* huomio: what a loaner wrote when picking up or returning a
/// loan. An admin triages it and may publish it as one or more `Announcement`s.
model Report {
  id            String               @id @default(cuid())
  content       String
  status        ReportStatus         @default(OPEN)
  createdAt     DateTime             @default(now())
  created       ReportCreated        @default(AFTER_LOAN)
  loanId        String
  loan          Loan                 @relation(fields: [loanId], references: [id], onDelete: Cascade)
  affectedItems ReportAffectedItem[]
  announcements Announcement[]
}

/// Which kamat a report concerns, tagged by an admin during triage. This is
/// bookkeeping only — it deliberately does NOT reduce availability, so a tagged
/// kama stays loanable. Publish a KORJATTAVAA announcement to warn loaners.
model ReportAffectedItem {
  id       String @id @default(cuid())
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  amount   Int

  @@unique([reportId, itemId])
}

enum Group {
  ADMIN
  USER
  KIOSK
}

enum ItemType {
  normal
  temporary
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ReportCreated {
  BEFORE_LOAN
  AFTER_LOAN
}

enum LoanStatus {
  ACCEPTED
  REJECTED
  CANCELLED
  INUSE
  IN_BOX
  PARTIALLY_RETURNED
  RETURNED
}

enum ReservationStatus {
  ACCEPTED
  REJECTED
  INUSE
  IN_BOX
  RETURNED
}

model EmailLog {
  id        String         @id @default(cuid())
  emailType EmailType
  loanId    String
  userId    String
  sentAt    DateTime       @default(now())
  loan      Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loanId, emailType, sentAt])
  @@index([userId, emailType, sentAt])
}

enum EmailType {
  EXPIRING_LOAN_REMINDER
  PICKUP_REMINDER
  /// Retired: `cron/startDueLoans` auto-starts loans that were never marked in
  /// use, so the nudge email is gone. Kept so old EmailLog rows still resolve.
  PICKUP_OVERDUE_REMINDER
  OVERDUE_USER_REMINDER
  OVERDUE_ADMIN_NOTIFICATION
  OLD_BOX_ADMIN_NOTIFICATION
}
