generator client {
  provider = "prisma-client-js"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output = "../ERD.pdf"
// }

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String         @id @default(cuid())
  name                     String?
  email                    String?        @unique
  emailVerified            DateTime?
  image                    String?
  // Soft delete: admin "delete user" sets this instead of hard-deleting the row,
  // so the user's loans and loan history survive. Deleted users are filtered out
  // of auth (can't log in), admin/loaner listings, elevation, and email/cron
  // recipients. Unset it (back to null) to restore the account.
  deletedAt                DateTime?
  group                    Group          @default(USER)
  password                 String?
  passwordExpiresAt        DateTime?
  // Recoverable (AES-256-GCM encrypted) copy of the KIOSK user's current
  // password, so admins can view it in the admin panel. `password` stays the
  // bcrypt hash used for auth; this is display-only. KIOSK rows only.
  kioskPasswordEnc         String?
  kioskElevatePin          String?
  username                 String?        @unique
  emailNewLoanNotification Boolean        @default(true)
  emailWeeklyReminder      Boolean        @default(true)
  emailOldBoxNotification  Boolean        @default(true)
  emailOverdueNotification Boolean        @default(true)
  accounts                 Account[]
  loans                    Loan[]
  sessions                 Session[]
  emailLogs                EmailLog[]
  loanHistoryEntries       LoanHistory[]
  itemHistoryEntries       ItemHistory[]

  @@index([deletedAt])
}

model Item {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  amount              Int
  locationId          String?
  type                ItemType             @default(normal)
  deletedAt           DateTime?
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservations        Reservation[]
  categories          Category[]           @relation("CategoryToItem")
  announcements       Announcement[]
  reportAffectedItems ReportAffectedItem[]
  history             ItemHistory[]
  templateItems       TemplateItem[]

  @@index([deletedAt])
}

/// A named, pre-picked set of items ("Vartion maastoretki") that a loaner can
/// drop into the cart in one go. Purely a shortcut for filling the cart: loans
/// keep no link back to the template they came from.
model Template {
  id          String         @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       TemplateItem[]
}

model TemplateItem {
  id         String   @id @default(cuid())
  templateId String
  itemId     String
  amount     Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([templateId, itemId])
}

model ItemHistory {
  id        String            @id @default(cuid())
  itemId    String
  action    ItemHistoryAction
  details   Json?
  actedById String?
  createdAt DateTime          @default(now())
  item      Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actedBy   User?             @relation(fields: [actedById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
}

enum ItemHistoryAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
  PROMOTED
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String?
}

model Location {
  name        String
  description String?
  id          String  @id @default(cuid())
  items       Item[]
}

model Box {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loans       Loan[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  items       Item[]  @relation("CategoryToItem")
}

model Reservation {
  id     String            @id @default(cuid())
  amount Int
  itemId String
  loanId String
  status ReservationStatus @default(ACCEPTED)
  item   Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  loan   Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Loan {
  id           String        @id @default(cuid())
  status       LoanStatus    @default(ACCEPTED)
  startTime    DateTime
  endTime      DateTime
  userId       String
  description  String?       @db.VarChar(100)
  loaner       String?
  boxId        String?
  box          Box?          @relation(fields: [boxId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reports      Report[]
  emailLogs    EmailLog[]
  history      LoanHistory[]
}

model LoanHistory {
  id        String            @id @default(cuid())
  loanId    String
  action    LoanHistoryAction
  details   Json?
  actedById String?
  createdAt DateTime          @default(now())
  loan      Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  actedBy   User?             @relation(fields: [actedById], references: [id], onDelete: SetNull)

  @@index([loanId, createdAt])
}

enum LoanHistoryAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  CANCELLED
  STARTED
  RETURNED_TO_BOX
  PROCESSED_FROM_BOX
}

model Report {
  id            String               @id @default(cuid())
  content       String
  status        ReportStatus         @default(OPEN)
  createdAt     DateTime             @default(now())
  created       ReportCreated        @default(AFTER_LOAN)
  loanId        String
  loan          Loan                 @relation(fields: [loanId], references: [id], onDelete: Cascade)
  affectedItems ReportAffectedItem[]
}

model ReportAffectedItem {
  id       String @id @default(cuid())
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  amount   Int

  @@unique([reportId, itemId])
}

enum Group {
  ADMIN
  USER
  KIOSK
}

enum ItemType {
  normal
  temporary
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ReportCreated {
  BEFORE_LOAN
  AFTER_LOAN
}

enum LoanStatus {
  ACCEPTED
  REJECTED
  CANCELLED
  INUSE
  IN_BOX
  PARTIALLY_RETURNED
  RETURNED
}

enum ReservationStatus {
  ACCEPTED
  REJECTED
  INUSE
  IN_BOX
  RETURNED
}

model EmailLog {
  id        String         @id @default(cuid())
  emailType EmailType
  loanId    String
  userId    String
  sentAt    DateTime       @default(now())
  loan      Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loanId, emailType, sentAt])
  @@index([userId, emailType, sentAt])
}

enum EmailType {
  EXPIRING_LOAN_REMINDER
  PICKUP_REMINDER
  PICKUP_OVERDUE_REMINDER
  OVERDUE_USER_REMINDER
  OVERDUE_ADMIN_NOTIFICATION
  OLD_BOX_ADMIN_NOTIFICATION
}
