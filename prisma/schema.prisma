generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String?   @unique
  emailVerified            DateTime?
  image                    String?
  group                    Group     @default(USER)
  password                 String?
  username                 String?   @unique
  emailNewLoanNotification Boolean   @default(true)
  emailWeeklyReminder      Boolean   @default(true)
  accounts                 Account[]
  loans                    Loan[]
  sessions                 Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id           String        @id @default(cuid())
  name         String
  description  String?
  image        String?
  amount       Int
  locationId   String?
  type         ItemType      @default(normal)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  categories   Category[]    @relation("CategoryToItem")
}

model Location {
  name        String
  description String?
  id          String  @id @default(cuid())
  items       Item[]
}

model Box {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loans       Loan[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  items       Item[]  @relation("CategoryToItem")
}

model Reservation {
  id     String @id @default(cuid())
  amount Int
  itemId String
  loanId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Loan {
  id           String        @id @default(cuid())
  status       LoanStatus    @default(ACCEPTED)
  startTime    DateTime
  endTime      DateTime
  userId       String
  description  String?       @db.VarChar(100)
  loaner       String?
  boxId        String?
  box          Box?          @relation(fields: [boxId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

enum Group {
  ADMIN
  USER
  KIOSK
}

enum ItemType {
  normal
  temporary
}

enum LoanStatus {
  ACCEPTED
  REJECTED
  INUSE
  IN_BOX
  RETURNED
}
